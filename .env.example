# The name of the Conda virtual environment to be created and used.
# default: pg_db
CONDA_ENV_NAME=

# default gets set dynamicall via jupytersetup.sh
POSTGRES_USER=
# default on local:
POSTGRES_PASSWORD=""
# default on local: localhost
POSTGRES_HOST=""
# default on local: 5432
POSTGRES_PORT=
# default: ara_wisper_db
POSTGRES_DBNAME=""

# The local directory where PostgreSQL will initialize its physical data cluster.
# default: pg_data_vault
DB_DATA_DIR=

# The local port where the Database FastAPI server will run and will be available via /proxy/<port>
# default: 3474 (leet for Data)
API_PORT=

# The Storage directory for the rag
# default: "~/project/storage/experiments"
STORAGE_DIR =