# The name of the Conda virtual environment to be created and used.
# default: rag
CONDA_ENV_NAME=

# The local port where the r2r control service will run and will be available via /proxy/<port>
# default: 8257 (8 and leet for RST)
CONTROL_PORT=

# default gets set dynamicall via jupytersetup.sh
POSTGRES_USER=
# default on local:
POSTGRES_PASSWORD=""
# default on local: localhost
POSTGRES_HOST=""
# default on local: 5432
POSTGRES_PORT=
# default: ara_wisper_db
POSTGRES_DBNAME=""


# The local port where the RAG will run and will be available
# default: 8246
RAG_PORT=

# The name of the collection used for vectoring in the PostgreSQL clust
# default: documents
COLLECTION_NAME=

# Keys needed by r2r sent via the control api that resets the r2r.serve
OPENAI_API_KEY=
OPENAI_API_BASE=